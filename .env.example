# Digital Krishi Officer - Environment Configuration
# Add your real API keys below.

# Google Gemini API Key
# Obtain from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# Weather API Key (Optional: Open-Meteo is built-in with zero configuration,
# or specify OpenWeatherMap key if preferred)
# Obtain from: https://openweathermap.org/api
WEATHER_API_KEY=YOUR_WEATHER_API_KEY

# Gemini Model Identifier (default: gemini-1.5-flash)
GEMINI_MODEL=gemini-1.5-flash
